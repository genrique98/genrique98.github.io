import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hola, I'm Gabe!</h1>
			<p>I'm an operations analyst and technical writer specializing in the tech industry.</p>

		</main>
		<Footer />
	</body>
</html>
